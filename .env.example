# Copy to .env (git-ignored) and fill in. The server reads it on start.

# Sign in with Google. Leave either value empty to hide the Google button.
# Create an OAuth client of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add each address the app is
# served from as an authorised redirect URI, ending in /api/auth/google/callback:
#   development: http://localhost:5173/api/auth/google/callback
#   production:  https://your-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Set in production so the redirect URI never depends on proxy headers.
# GOOGLE_REDIRECT_URI=https://your-domain/api/auth/google/callback
